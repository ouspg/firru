table inet filtering_policies {
    chain allow-icmp-any-shared {
        ip daddr { 10.20.3.21/32, 10.20.3.22/32, 10.20.3.23/32 } ip protocol icmp ct state new accept
        ip6 daddr { 2001:db8:20:3::15/128, 2001:db8:20:3::16/128, 2001:db8:20:3::17/128 } ip protocol icmp ct state new accept
    }
    chain allow-icmpv6-any-shared {
        ip daddr { 10.20.3.21/32, 10.20.3.22/32, 10.20.3.23/32 } meta l4proto icmpv6 accept
        ip6 daddr { 2001:db8:20:3::15/128, 2001:db8:20:3::16/128, 2001:db8:20:3::17/128 } meta l4proto icmpv6 accept
    }
    chain ws1-allow-tcp-WINDOWS-RPC-ENDPOINT-MAPPER {
        ip saddr 0.0.0.0/0 ip daddr 10.20.3.21/32 tcp dport 135 ct state new accept
        ip6 saddr ::/0 ip6 daddr 2001:db8:20:3::15/128 tcp dport 135 ct state new accept
    }
    chain ws1-allow-tcp-WINDOWS-SMB {
        ip saddr 0.0.0.0/0 ip daddr 10.20.3.21/32 tcp dport 445 ct state new accept
        ip6 saddr ::/0 ip6 daddr 2001:db8:20:3::15/128 tcp dport 445 ct state new accept
    }
    chain ws1-allow-udp-NTP {
        ip saddr 0.0.0.0/0 ip daddr 10.20.3.21/32 udp dport 123 ct state new accept
        ip6 saddr ::/0 ip6 daddr 2001:db8:20:3::15/128 udp dport 123 ct state new accept
    }
    chain deny-ext-tcp-NETBIOS-SSN-LEGACY {
        comment "intra-zone only — port is open on host(s) but no legitimate external traffic observed; host firewall handles intra-zone access"
        ip daddr 10.20.3.21/32 tcp dport 139 drop
        ip6 daddr 2001:db8:20:3::15/128 tcp dport 139 drop
    }
    chain deny-ext-udp-NETBIOS-DGM-LEGACY {
        comment "intra-zone only — port is open on host(s) but no legitimate external traffic observed; host firewall handles intra-zone access"
        ip daddr 10.20.3.21/32 udp dport 138 drop
        ip6 daddr 2001:db8:20:3::15/128 udp dport 138 drop
    }
    chain deny-ext-udp-NETBIOS-NS-LEGACY {
        comment "intra-zone only — port is open on host(s) but no legitimate external traffic observed; host firewall handles intra-zone access"
        ip daddr 10.20.3.21/32 udp dport 137 drop
        ip6 daddr 2001:db8:20:3::15/128 udp dport 137 drop
    }
    chain drop-ghost-hosts {
        comment "Ghost host catch-all: drops traffic to IPs in CLIENTS not matched by any allow term above.  All legitimate hosts should appear in policies/pol/ and be covered by explicit allow terms."
        ip daddr 10.20.3.0/24 drop
        ip6 daddr 2001:db8:20:3::/64 drop
    }
    chain log-drop-ANY {
        comment "SETTLING: drop + log unmatched traffic to catch false positives. Promote to drop (--terminal drop) when the log has been quiet."
        log prefix "log-drop-ANY" drop
    }
    chain root0 {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        jump allow-icmp-any-shared
        jump allow-icmpv6-any-shared
        jump ws1-allow-tcp-WINDOWS-RPC-ENDPOINT-MAPPER
        jump ws1-allow-tcp-WINDOWS-SMB
        jump ws1-allow-udp-NTP
        jump deny-ext-tcp-NETBIOS-SSN-LEGACY
        jump deny-ext-udp-NETBIOS-DGM-LEGACY
        jump deny-ext-udp-NETBIOS-NS-LEGACY
        jump drop-ghost-hosts
        jump log-drop-ANY
    }
}

