# Host: dc1  IPs: 192.168.150.194
# Policy: policies/pol/dc1.yml

# [allow-tcp-KERBEROS-TCP] tcp/88 restricted to ['ADMIN', 'win1'] — SYN inbound (centralized FW failed, host FW may hold)
(dst host 192.168.150.194 and tcp dst port 88 and tcp[13] & 0x12 == 0x02 and not (src net 192.168.150.0/28 or src net 192.168.150.184/32))

# [allow-tcp-KERBEROS-TCP] tcp/88 restricted to ['ADMIN', 'win1'] — SYN-ACK outbound (both firewalls failed)
(src host 192.168.150.194 and tcp src port 88 and tcp[13] & 0x12 == 0x12 and not (dst net 192.168.150.0/28 or dst net 192.168.150.184/32))

